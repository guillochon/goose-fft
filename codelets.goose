fn has_codelet(n: i64) -> bool {
    match n {
        2 => true,
        3 => true,
        4 => true,
        5 => true,
        6 => true,
        8 => true,
        _ => false,
    }
}

// The codelet for a.len, which must have one.
inline fn codelet(a: cv4[:]) {
    match a.len {
        2 => dft2(a),
        3 => dft3(a),
        4 => dft4(a),
        5 => dft5(a),
        6 => dft6(a),
        8 => dft8(a),
        _ => abort("no codelet for this length"),
    }
}
